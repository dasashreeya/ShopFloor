# OpenRouter (https://openrouter.ai/keys). Leave empty to run fully offline with the fake LLM.
OPENROUTER_API_KEY=
# Optional attribution headers sent to OpenRouter
OPENROUTER_SITE_URL=https://github.com/dasashreeya/ShopFloor
OPENROUTER_APP_TITLE=ShopFloor

# Model routing (any OpenRouter model slug)
SHOPFLOOR_MODEL_FAST=anthropic/claude-haiku-5.5
SHOPFLOOR_MODEL_SMART=anthropic/claude-sonnet-5.5
# Judge is a different model family on purpose, to reduce self-preference bias in lab grading
SHOPFLOOR_MODEL_JUDGE=google/gemini-3.8-flash

# auto = OpenRouter if a key is set, else fake.  Force with: openrouter | fake
SHOPFLOOR_LLM_MODE=auto
SHOPFLOOR_DB_PATH=data/shopfloor.db
